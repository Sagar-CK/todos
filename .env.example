# Optional. Leave both empty to use Todos locally without an account.
# Use your project's publishable or legacy anon key. Never use a secret/service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Use the same values when building for Mac and iPhone.
# Choose a unique reverse-domain ID before signing the iOS app.
TODOS_BUNDLE_ID=com.example.todos
TODOS_URL_SCHEME=todos
# Optional: 10-character Apple development team ID.
TODOS_DEVELOPMENT_TEAM=
